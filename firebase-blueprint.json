{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered staff or admin account for Prime Mobiles.",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "Full display name of the staff member or admin.",
          "minLength": 1,
          "maxLength": 120
        },
        "username": {
          "type": "string",
          "description": "Unique lowercase username with no spaces.",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "^[a-z0-9_.-]+$"
        },
        "password": {
          "type": "string",
          "description": "User account password (minimum 4 characters).",
          "minLength": 4,
          "maxLength": 128
        },
        "phoneNumber": {
          "type": "string",
          "description": "Unique phone number for the staff member.",
          "minLength": 4,
          "maxLength": 40
        },
        "role": {
          "type": "string",
          "description": "User role determining permissions.",
          "enum": ["Admin", "Staff"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when the account was created."
        }
      },
      "required": ["fullName", "username", "password", "phoneNumber", "role", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Wholesale mobile/accessory inventory item.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Product name.",
          "minLength": 1,
          "maxLength": 150
        },
        "category": {
          "type": "string",
          "description": "Product category.",
          "minLength": 1,
          "maxLength": 80
        },
        "costPrice": {
          "type": "number",
          "description": "Wholesale cost price in Rs (visible to Admin only)."
        },
        "sellingPrice": {
          "type": "number",
          "description": "Selling price in Rs."
        },
        "stockQuantity": {
          "type": "number",
          "description": "Current stock count."
        },
        "previousStockQuantity": {
          "type": "number",
          "description": "Optional previous stock before marking out of stock."
        },
        "approvalStatus": {
          "type": "string",
          "description": "Approval state when added by staff vs admin.",
          "enum": ["Approved", "Pending Approval", "Rejected"]
        },
        "createdBy": {
          "type": "string",
          "description": "Name of user who added the product.",
          "maxLength": 120
        },
        "createdByRole": {
          "type": "string",
          "enum": ["Admin", "Staff"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastUpdatedBy": {
          "type": "string",
          "maxLength": 120
        },
        "lastUpdatedAt": {
          "type": "string",
          "maxLength": 80
        }
      },
      "required": ["name", "category", "costPrice", "sellingPrice", "stockQuantity", "approvalStatus", "createdBy", "createdByRole", "createdAt"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily staff attendance record (max one per staff per day).",
      "type": "object",
      "properties": {
        "staffId": {
          "type": "string",
          "maxLength": 128
        },
        "staffName": {
          "type": "string",
          "maxLength": 120
        },
        "staffUsername": {
          "type": "string",
          "maxLength": 60
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "month": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "time": {
          "type": "string",
          "maxLength": 40
        },
        "workType": {
          "type": "string",
          "enum": ["Shop Work", "Work From Home"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["staffId", "staffName", "staffUsername", "date", "month", "time", "workType", "createdAt"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Global wholesale store configuration managed by Admin.",
      "type": "object",
      "properties": {
        "businessName": {
          "type": "string",
          "maxLength": 120
        },
        "phoneNumber": {
          "type": "string",
          "maxLength": 40
        },
        "lowStockLimit": {
          "type": "number"
        },
        "discountPercent": {
          "type": "number"
        },
        "discountTitle": {
          "type": "string",
          "maxLength": 100
        },
        "discountActive": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string"
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 120
        }
      },
      "required": ["businessName", "phoneNumber", "lowStockLimit", "discountPercent", "discountTitle", "discountActive", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Real-time low stock and out-of-stock alerts.",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "maxLength": 128
        },
        "productName": {
          "type": "string",
          "maxLength": 150
        },
        "stockQuantity": {
          "type": "number"
        },
        "message": {
          "type": "string",
          "maxLength": 300
        },
        "severity": {
          "type": "string",
          "enum": ["LOW_STOCK", "OUT_OF_STOCK"]
        },
        "createdAt": {
          "type": "string"
        },
        "dismissed": {
          "type": "boolean"
        }
      },
      "required": ["productId", "productName", "stockQuantity", "message", "severity", "createdAt", "dismissed"]
    },
    "Order": {
      "title": "Order",
      "description": "Wholesale delivery and order logs marked by staff or admin.",
      "type": "object",
      "properties": {
        "customerName": {
          "type": "string",
          "maxLength": 120
        },
        "productId": {
          "type": "string",
          "maxLength": 128
        },
        "productName": {
          "type": "string",
          "maxLength": 150
        },
        "quantity": {
          "type": "number"
        },
        "unitSellingPrice": {
          "type": "number"
        },
        "totalAmount": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Delivered"]
        },
        "markedBy": {
          "type": "string",
          "maxLength": 120
        },
        "markedByUsername": {
          "type": "string",
          "maxLength": 60
        },
        "createdAt": {
          "type": "string"
        },
        "deliveredAt": {
          "type": "string"
        }
      },
      "required": ["customerName", "productId", "productName", "quantity", "unitSellingPrice", "totalAmount", "status", "markedBy", "markedByUsername", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Registered Admin and Staff accounts."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Wholesale product catalog and stock levels."
    },
    "/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/Attendance" },
      "description": "Daily attendance records keyed by staffId_YYYY-MM-DD."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Storewide settings document (storeConfig)."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Active low-stock and out-of-stock notifications."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Wholesale delivery and order logs."
    }
  }
}
